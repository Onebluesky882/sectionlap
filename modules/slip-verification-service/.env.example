# Slip Verification Service — Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=8090

# Slip2Go (bank-slip QR verification)
SLIP2GO_API_URL=https://connect.slip2go.com
SLIP_2GO_SECRET=

# Shared secret required in the X-Internal-Secret header by every caller
INTERNAL_SECRET=changeme-use-a-long-random-string-here
