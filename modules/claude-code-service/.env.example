PORT=9100

# From `claude setup-token` — authenticates the Claude Code CLI headlessly
# against your Claude subscription (not a pay-per-token API key).
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret the Go backend must send as X-Internal-Secret.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=

# Optional — defaults to a fast/cheap model, fine for structured extraction.
CLAUDE_CODE_MODEL=claude-haiku-4-5-20251001
